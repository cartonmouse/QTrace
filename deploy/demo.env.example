# Copy this file to deploy/demo.env and replace the JWT secret locally.
# Never commit deploy/demo.env and never put an LLM API key in this file.
REBUILD_JWT_SECRET=replace-with-a-long-random-demo-secret
REBUILD_ALLOWED_ORIGINS=http://localhost:8080
REBUILD_BYOK_STORAGE_MODE=session
REBUILD_BLOCK_PRIVATE_API_BASE=true
QTRACE_DEMO_PORT=8080
# If the VPS cannot reach public package registries, override these two build-only mirrors.
# Tencent Cloud mainland example:
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
# NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
